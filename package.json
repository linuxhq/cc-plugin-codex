{
  "name": "cc-plugin-codex",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "node scripts/validate.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run validate && npm test",
    "check": "npm run lint && npm run format:check && npm run verify"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "yaml": "2.9.0"
  }
}
