{
  "description": "Optional Claude review before Codex finishes a turn.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/stop-review-gate-hook.mjs\"",
            "timeout": 900,
            "statusMessage": "Reviewing the turn with Claude"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/stop-review-gate-hook.mjs\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
